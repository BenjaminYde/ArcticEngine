{
	"name": "arctic-engine_ubuntu24_x64",
	"dockerComposeFile": "docker-compose.yaml",
	"service": "devcontainer",
	"workspaceFolder": "/home/developer/ArcticEngine",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cmake-tools",
				"mhutchie.git-graph",
				"marlongerson.jetbrains-icons",
				"llvm-vs-code-extensions.vscode-clangd",
				"llvm-vs-code-extensions.lldb-dap",
				"xaver.clang-format",
				"ms-python.python",
				"chrisdias.vscode-opennewinstance",
				"NarasimaPandiyan.jetbrainsmono",
				"shader-slang.slang-language-extension",
				"Anthropic.claude-code"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh",
				"terminal.integrated.profiles.linux": {
					"Azure Cloud Shell (Bash)": null,
					"Azure Cloud Shell (PowerShell)": null,
					"JavaScript Debug Terminal": null,
					"bash": null,
					"zsh": {
						"path": "/usr/bin/zsh"
					}
				}
			}
		}
	},
	"initializeCommand": ".devcontainer/bootstrap_host.sh",
	"onCreateCommand": ".devcontainer/bootstrap_container.sh"
}