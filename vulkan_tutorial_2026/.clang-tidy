# .clang-tidy
# C++ Core Guidelines: https://isocpp.github.io/CppCoreGuidelines

Checks: >

  # C++ Core Guidelines
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-cstyle-cast,

  # Enforce modern C++ patterns
  modernize-*,
  -modernize-use-trailing-return-type,

  # Readability and consistency
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-braces-around-statements,
  -readability-uppercase-literal-suffix,
  -readability-implicit-bool-conversion,
  -readability-math-missing-parentheses,
  -readability-convert-member-functions-to-static,

  # Patterns statistically associated with bugs
  bugprone-*,
  -bugprone-easily-swappable-parameters,

  # Accidental copies, missed moves, inefficient patterns
  performance-*,

  # Misc
  misc-const-correctness,
  misc-unused-parameters,
  misc-unused-alias-decls,
  misc-redundant-expression,
  misc-use-anonymous-namespace,
  misc-coroutine-hostile-raii,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,

  # No mutable global state — forces encapsulation into classes or namespaces
  # Bad:  int g_frameCount = 0;
  # Good: class Renderer { int m_frameCount = 0; };
  cppcoreguidelines-avoid-non-const-global-variables,

  # Virtual base classes must have virtual or protected destructor
  # Bad:  struct Base { virtual void draw(); ~Base() {} };
  # Good: struct Base { virtual void draw(); virtual ~Base() = default; };
  cppcoreguidelines-virtual-class-destructor,

  # All members must be initialized — reading uninitialized values is UB
  # Bad:  struct Foo { int x; float y; };
  # Good: struct Foo { int x = 0; float y = 0.0f; };
  cppcoreguidelines-pro-type-member-init,

  # const/ref members silently delete copy/move assignment
  # Bad:  struct Foo { const int id; };
  # Good: struct Foo { int id; };
  cppcoreguidelines-avoid-const-or-ref-data-members,

  # Single-argument constructors must be explicit — prevents implicit conversions
  # Bad:  struct Path { Path(std::string s); };  Path p = "foo";
  # Good: struct Path { explicit Path(std::string s); };
  hicpp-explicit-conversions,

  # enum must be enum class — prevents name collisions and implicit int casts
  # Bad:  enum Color { Red, Green };
  # Good: enum class Color { Red, Green };
  modernize-use-scoped-enum,

  # No else after return/break/continue — reduces nesting
  # Bad:  if (error) { return; } else { doWork(); }
  # Good: if (error) { return; } doWork();
  readability-else-after-return,

  # Replace printf/cout with C++23 std::print
  # Bad:  printf("value: %d\n", x);
  # Good: std::println("value: {}", x);
  modernize-use-std-print,

  # Unchecked *opt access without has_value() guard
  # Bad:  auto val = getOptional(); int x = *val;
  # Good: auto val = getOptional(); if (val) { int x = *val; }
  bugprone-unchecked-optional-access,

  # string_view.data() is not null-terminated — unsafe to pass to C APIs
  # Bad:  fopen(path.data(), "r");
  # Good: fopen(std::string{path}.c_str(), "r");
  bugprone-suspicious-stringview-data-usage,

  # Exceptions must derive from std::exception
  # Bad:  throw "something went wrong";
  # Good: throw std::runtime_error{"something went wrong"};
  hicpp-exception-baseclass,

  # switch must cover all enum values or have a default
  # Bad:  switch (color) { case Red: ...; case Green: ...; }
  # Good: switch (color) { case Red: ...; case Green: ...; default: ...; }
  hicpp-multiway-paths-covered,

  # MT-unsafe C functions: rand(), strtok(), localtime(), asctime() etc.
  # Bad:  int r = rand();
  # Good: std::mt19937 rng{std::random_device{}()};
  concurrency-mt-unsafe,

  # RAII types (locks) held across co_await — deadlock risk
  # Bad:  std::lock_guard lock{m}; co_await asyncWork();
  # Good: { std::lock_guard lock{m}; } co_await asyncWork();
  misc-coroutine-hostile-raii,

# These are errors — the build breaks if triggered
WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  bugprone-macro-parentheses,
  bugprone-misplaced-widening-cast,
  bugprone-suspicious-memory-comparison,
  bugprone-narrowing-conversions,
  bugprone-move-forwarding-reference,
  bugprone-virtual-near-miss,
  bugprone-exception-escape,
  bugprone-unchecked-optional-access,
  clang-diagnostic-vexing-parse,
  performance-move-const-arg,
  performance-no-automatic-move,
  performance-no-int-to-ptr,
  performance-trivially-destructible,
  modernize-use-nullptr,
  modernize-use-override,
  hicpp-exception-baseclass,
  cppcoreguidelines-avoid-const-or-ref-data-members,

CheckOptions:

  # Function size
  - key:   readability-function-size.StatementThreshold
    value: '50'
  - key:   readability-function-size.LineThreshold
    value: '100'
  - key:   readability-function-size.NestingThreshold
    value: '5'
  - key:   readability-function-cognitive-complexity.Threshold
    value: '25'

  # Naming
  - key:   readability-identifier-naming.LocalVariableCase
    value: 'camelBack'
  - key:   readability-identifier-naming.ParameterCase
    value: 'camelBack'
  - key:   readability-identifier-naming.MemberCase
    value: 'camelBack'
  - key:   readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key:   readability-identifier-naming.ClassCase
    value: 'CamelCase'
  - key:   readability-identifier-naming.FunctionCase
    value: 'camelBack'
  - key:   readability-identifier-naming.ConstantCase
    value: 'UPPER_CASE'
  - key:   readability-identifier-naming.EnumCase
    value: 'CamelCase'
  - key:   readability-identifier-naming.EnumConstantCase
    value: 'CamelCase'
  - key:   readability-identifier-naming.StaticConstantCase
    value: 'UPPER_CASE'
  - key:   readability-identifier-naming.StaticVariableCase
    value: 'camelBack'
  - key:   readability-identifier-naming.NamespaceCase
    value: 'lower_case'
  - key:   readability-identifier-naming.FunctionPrefix
    value: ''

  # Rule of Zero — let the compiler generate move/copy/dtor where possible
  - key:   cppcoreguidelines-special-member-functions.AllowMissingMoveFunctions
    value: 'true'
  - key:   cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'

  - key:   modernize-make-unique.MakeSmartPtrFunction
    value: 'std::make_unique'
  - key:   modernize-make-unique.IgnoreMacros
    value: 'true'
  - key:   modernize-use-noexcept.UseNoexceptFalse
    value: 'false'
  - key:   readability-qualified-auto.AddConstToQualified
    value: 'true'
  - key:   readability-const-return-type.IgnoreMacros
    value: 'true'
  - key:   modernize-use-using.IgnoreMacros
    value: 'true'