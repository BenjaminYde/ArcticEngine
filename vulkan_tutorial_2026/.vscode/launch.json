{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "LLDB: Debug CMake target",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "initCommands": [
                "settings set symbols.enable-external-lookup false"
            ],
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "LLDB: Debug CTest",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${cmake.testProgram}",
            "args": [
                "${cmake.testArgs}",
                "${input:runArgs}"
            ],
            "cwd": "${cmake.testWorkingDirectory}",
            "console": "integratedTerminal",
            "initCommands": [
                "settings set symbols.enable-external-lookup false"
            ],
            "presentation": {
                "hidden": true
            }
        },
    ],
    "inputs": [
        {
            "id": "runArgs",
            "type": "promptString",
            "description": "Extra args for the program, e.g. --gtest_filter=Suite.Case (leave empty for none)",
            "default": ""
        }
    ]
}