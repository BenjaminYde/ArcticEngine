{
    // ----------------------------------------------------------------
    // Editor
    // ----------------------------------------------------------------
    "editor.formatOnSave": true,
    "editor.rulers": [
        140
    ],
    "files.trimTrailingWhitespace": true,
    // ----------------------------------------------------------------
    // CMake — tools extension
    // ----------------------------------------------------------------
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.options.advanced": {
        "configurePreset": {
            "statusBarVisibility": "visible",
            "inheritDefault": "visible"
        },
        "build": {
            "statusBarVisibility": "visible",
            "inheritDefault": "visible"
        },
        "buildPreset": {
            "statusBarVisibility": "visible",
            "inheritDefault": "visible"
        },
        "debug": {
            "statusBarVisibility": "visible",
            "inheritDefault": "visible"
        },
        "ctest": {
            "statusBarVisibility": "compact",
        },
        "launchTarget": {
            "statusBarVisibility": "compact"
        },
        "launch": {
            "statusBarVisibility": "visible"
        }
    },
    "cmake.ctest.testExplorerIntegrationEnabled": true,
    "cmake.debugConfig": {
        "type": "lldb-dap",
        "request": "launch",
        "console": "integratedTerminal",
        "initCommands": [
            "settings set symbols.enable-external-lookup false"
        ]
    },
    "cmake.ctest.allowParallelJobs": true,
    "lldb-dap.executable-path": "/usr/bin/lldb-dap-22",
    // ----------------------------------------------------------------
    // File associations
    // ----------------------------------------------------------------
    "files.associations": {
        "*.h": "cpp",
        "*.cpp": "cpp",
        ".clang-tidy": "yaml",
        ".clang-format": "yaml"
    },
    // ----------------------------------------------------------------
    // Formatting
    // ----------------------------------------------------------------
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format",
        "editor.formatOnSave": true
    },
    // ----------------------------------------------------------------
    // Search / watcher exclusions (build artefacts)
    // ----------------------------------------------------------------
    "search.exclude": {
        "**/build/**": true,
        "**/install/**": true,
        "**/.cache/**": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/install/**": true
    },
    // ----------------------------------------------------------------
    // Intellisense
    // ----------------------------------------------------------------
    "C_Cpp.intelliSenseEngine": "disabled"
}